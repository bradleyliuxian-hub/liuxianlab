import os
from contextlib import contextmanager
from pathlib import Path

import psycopg
from psycopg.rows import dict_row
from dotenv import load_dotenv


PROJECT_ROOT = Path(__file__).resolve().parents[2]

load_dotenv(
    PROJECT_ROOT / ".env"
)


WORKER_LOCK_KEY = 527894221


def get_database_url():
    database_url = os.getenv(
        "DATABASE_URL"
    )

    if not database_url:
        raise RuntimeError(
            "DATABASE_URL is not configured"
        )

    return database_url


def connect():
    return psycopg.connect(
        get_database_url()
    )


@contextmanager
def contract_worker_lock():
    """
    Allow only one MinerU contract worker
    to run at the same time.
    """

    conn = connect()
    conn.autocommit = True

    locked = False

    try:

        with conn.cursor() as cur:

            cur.execute(
                """
                SELECT pg_try_advisory_lock(%s)
                """,
                (
                    WORKER_LOCK_KEY,
                ),
            )

            row = cur.fetchone()

            locked = bool(
                row[0]
            )

        yield locked

    finally:

        if locked:

            try:

                with conn.cursor() as cur:

                    cur.execute(
                        """
                        SELECT pg_advisory_unlock(%s)
                        """,
                        (
                            WORKER_LOCK_KEY,
                        ),
                    )

            except Exception:
                pass

        conn.close()


def ping_database():

    with connect() as conn:

        with conn.cursor() as cur:

            cur.execute(
                """
                SELECT
                    current_database(),
                    current_user,
                    NOW()
                """
            )

            row = cur.fetchone()

    return {
        "database": row[0],
        "user": row[1],
        "server_time": row[2],
    }


def count_contracts():

    with connect() as conn:

        with conn.cursor() as cur:

            cur.execute(
                """
                SELECT COUNT(*)
                FROM contracts
                """
            )

            row = cur.fetchone()

    return int(
        row[0]
    )


def claim_contract(
    contract_id
):
    """
    Atomically claim one specific queued contract.
    """

    with connect() as conn:

        with conn.cursor(
            row_factory=dict_row
        ) as cur:

            cur.execute(
                """
                UPDATE contracts

                SET
                    status = 'processing',
                    stage = 'parsing',
                    progress = 10,
                    error_message = NULL,
                    updated_at = NOW()

                WHERE
                    id = %s
                    AND status = 'queued'
                    AND stage = 'queued'

                RETURNING
                    id,
                    owner_username,
                    original_name,
                    stored_name,
                    file_path,
                    size_bytes,
                    mime_type,
                    status,
                    stage,
                    progress,
                    created_at,
                    updated_at
                """,
                (
                    contract_id,
                ),
            )

            row = cur.fetchone()

    if row is None:
        return None

    return dict(
        row
    )


def claim_next_contract():
    """
    Atomically claim the oldest queued contract.
    """

    sql = """
        WITH next_job AS (

            SELECT id

            FROM contracts

            WHERE
                status = 'queued'
                AND stage = 'queued'

            ORDER BY created_at ASC

            FOR UPDATE SKIP LOCKED

            LIMIT 1
        )

        UPDATE contracts AS c

        SET
            status = 'processing',
            stage = 'parsing',
            progress = 10,
            error_message = NULL,
            updated_at = NOW()

        FROM next_job

        WHERE
            c.id = next_job.id

        RETURNING
            c.id,
            c.owner_username,
            c.original_name,
            c.stored_name,
            c.file_path,
            c.size_bytes,
            c.mime_type,
            c.status,
            c.stage,
            c.progress,
            c.created_at,
            c.updated_at
    """

    with connect() as conn:

        with conn.cursor(
            row_factory=dict_row
        ) as cur:

            cur.execute(
                sql
            )

            row = cur.fetchone()

    if row is None:
        return None

    return dict(
        row
    )


def get_contract(
    contract_id
):

    with connect() as conn:

        with conn.cursor(
            row_factory=dict_row
        ) as cur:

            cur.execute(
                """
                SELECT
                    id,
                    owner_username,
                    original_name,
                    stored_name,
                    file_path,
                    size_bytes,
                    mime_type,
                    status,
                    stage,
                    progress,
