(() => {
  "use strict";


  const params =
    new URLSearchParams(
      window.location.search
    );


  const contractId =
    params.get("id");


  const editor =
    document.getElementById(
      "draftEditor"
    );


  let issueDocument = {
    issues: []
  };


  let panel = null;
  let list = null;
  let countBadge = null;
  let summaryText = null;


  function openIssues() {

    return (
      issueDocument.issues
      || []
    ).filter(
      issue =>
        issue.status !==
        "resolved"
    );

  }


  function getOpenCount() {

    return openIssues().length;

  }


  async function requestJson(
    url,
    options = {}
  ) {

    const headers = {
      Accept:
        "application/json",

      ...(options.headers || {})
    };


    if (
      options.body
      &&
      !headers["Content-Type"]
    ) {

      headers["Content-Type"] =
        "application/json";

    }


    const response =
      await fetch(
        url,
        {
          credentials:
            "same-origin",

          ...options,

          headers
        }
      );


    let payload =
      null;


    try {

      payload =
        await response.json();

    } catch (_) {
      // Ignore malformed response.
    }


    if (
      !response.ok
      ||
      !payload?.ok
    ) {

      throw new Error(
        payload?.error
        ||
        `请求失败：${response.status}`
      );

    }


    return payload;

  }


  function createPanel() {

    if (
      panel
      ||
      !editor
    ) {
      return;
    }


    panel =
      document.createElement(
        "section"
      );


    panel.id =
      "ocrIssuesPanel";


    panel.className =
      "ocr-issues-panel";


    const header =
      document.createElement(
        "div"
      );


    header.className =
      "ocr-issues-header";


    const titleGroup =
      document.createElement(
        "div"
      );


    titleGroup.className =
      "ocr-issues-title-group";


    const title =
      document.createElement(
        "strong"
      );


    title.textContent =
      "OCR 待核对项";


    countBadge =
      document.createElement(
        "span"
      );


    countBadge.className =
      "ocr-issues-count";


    titleGroup.appendChild(
      title
    );

    titleGroup.appendChild(
      countBadge
    );


    summaryText =
      document.createElement(
        "span"
      );


    summaryText.className =
      "ocr-issues-summary";


    header.appendChild(
      titleGroup
    );

    header.appendChild(
      summaryText
    );


    list =
      document.createElement(
        "div"
      );


    list.className =
      "ocr-issues-list";


    panel.appendChild(
      header
    );

    panel.appendChild(
      list
    );


    editor.parentElement.insertBefore(
      panel,
      editor
    );

  }


  function severityLabel(
    severity
  ) {

    if (
      severity === "error"
    ) {
      return "高风险";
    }


    return "建议核对";

  }


  function locateText(
    text
  ) {

    if (
      !editor
      ||
      !text
    ) {
      return false;
    }


    const index =
      editor.value.indexOf(
        text
      );


    if (
      index < 0
    ) {

      window.alert(
        `当前校对稿中没有找到：\n${text}\n\n该内容可能已经被人工修改。`
      );

      return false;

    }


    editor.focus();


    editor.setSelectionRange(
      index,
      index + text.length
    );


    const before =
      editor.value.slice(
        0,
        index
      );


    const lineCount =
      before.split("\n").length;


    const computed =
      window.getComputedStyle(
        editor
      );


    const lineHeight =
      parseFloat(
        computed.lineHeight
      ) || 24;


    editor.scrollTop =
      Math.max(
        0,
        (
          lineCount - 4
        )
        * lineHeight
      );


    return true;

  }


  function applySuggestion(
    issue
  ) {

    const source =
      String(
        issue.sourceText
        || ""
      );


    const suggestion =
      String(
        issue.suggestedText
        || ""
      );


    if (
      !source
      ||
      !suggestion
    ) {

      window.alert(
        "这个问题没有可自动采用的建议，请人工检查。"
      );

      return;

    }


    const index =
      editor.value.indexOf(
        source
      );


    if (
      index < 0
    ) {

      window.alert(
        "当前校对稿中已经找不到原 OCR 文字，可能已经修改过。"
      );

      return;

    }


    editor.value =
      editor.value.slice(
        0,
        index
      )
      +
      suggestion
      +
      editor.value.slice(
        index + source.length
      );


    /*
     * Trigger review.js input handler:
     * - mark draft dirty
     * - update character count
     */
    editor.dispatchEvent(
      new Event(
        "input",
        {
          bubbles: true
        }
      )
    );


    locateText(
      suggestion
    );

  }


  async function resolveIssue(
    issue
  ) {

    const confirmed =
      window.confirm(
        `确认该项已经人工核对？\n\n${issue.title}`
      );


    if (!confirmed) {
      return;
    }


    try {

      await requestJson(
        `/api/contracts/${
          encodeURIComponent(
            contractId
          )
        }/issues/${
          encodeURIComponent(
            issue.id
          )
        }/resolve`,
        {
          method:
            "POST",

          body:
            JSON.stringify({
              resolution:
                "reviewed",

              note:
                ""
            })
        }
      );


      await loadIssues();


    } catch (error) {

      window.alert(
        `无法确认该问题：${error.message}`
      );

    }

  }


  function makeTextRow(
    label,
    value,
    className = ""
  ) {

    const row =
      document.createElement(
        "div"
      );


    row.className =
      `ocr-issue-text-row ${className}`;


    const labelNode =
      document.createElement(
        "span"
      );


    labelNode.className =
      "ocr-issue-text-label";


    labelNode.textContent =
      label;


    const valueNode =
      document.createElement(
        "code"
      );


    valueNode.textContent =
      value || "—";


    row.appendChild(
      labelNode
    );

    row.appendChild(
      valueNode
    );


    return row;

  }


  function renderIssue(
    issue
  ) {

    const card =
      document.createElement(
        "article"
      );


    card.className =
      [
        "ocr-issue-card",
        `severity-${issue.severity || "warning"}`,
        issue.status === "resolved"
          ? "is-resolved"
          : ""
      ]
        .filter(Boolean)
        .join(" ");


    const top =
      document.createElement(
        "div"
      );


    top.className =
      "ocr-issue-card-top";


    const title =
      document.createElement(
        "strong"
      );


    title.textContent =
      issue.title
      || "OCR 待核对";


    const severity =
      document.createElement(
        "span"
      );


    severity.className =
      "ocr-issue-severity";


    severity.textContent =
      issue.status === "resolved"
        ? "已核对"
        : severityLabel(
            issue.severity
          );


    top.appendChild(
      title
    );

    top.appendChild(
      severity
    );


    card.appendChild(
      top
    );


    if (
      issue.message
    ) {

      const message =
        document.createElement(
          "div"
        );


      message.className =
        "ocr-issue-message";


      message.textContent =
        issue.message;


      card.appendChild(
        message
      );

    }


    if (
      issue.sourceText
    ) {

      card.appendChild(
        makeTextRow(
          "OCR",
          issue.sourceText,
          "ocr-source"
        )
      );

    }


    if (
      issue.suggestedText
    ) {

      card.appendChild(
        makeTextRow(
          "建议",
          issue.suggestedText,
          "ocr-suggestion"
        )
      );

    }


    if (
      issue.status !==
      "resolved"
    ) {

      const actions =
        document.createElement(
          "div"
        );


      actions.className =
        "ocr-issue-actions";


      if (
        issue.sourceText
      ) {

        const locateButton =
          document.createElement(
            "button"
          );


        locateButton.type =
          "button";


        locateButton.className =
          "ocr-issue-button";


        locateButton.textContent =
          "定位文字";


        locateButton.addEventListener(
          "click",
          () => {

            locateText(
              issue.sourceText
            );

          }
        );


        actions.appendChild(
          locateButton
        );

      }


      if (
        issue.sourceText
        &&
        issue.suggestedText
      ) {

        const suggestionButton =
          document.createElement(
            "button"
          );


        suggestionButton.type =
          "button";


        suggestionButton.className =
          "ocr-issue-button";


        suggestionButton.textContent =
          "采用建议";


        suggestionButton.addEventListener(
          "click",
          () => {

            applySuggestion(
              issue
            );

          }
        );


        actions.appendChild(
          suggestionButton
        );

      }


      const resolveButton =
        document.createElement(
          "button"
        );


      resolveButton.type =
        "button";


      resolveButton.className =
        "ocr-issue-button ocr-issue-button-primary";


      resolveButton.textContent =
        "已核对";


      resolveButton.addEventListener(
        "click",
        () => {

          resolveIssue(
            issue
          );

        }
      );


      actions.appendChild(
        resolveButton
      );


      card.appendChild(
        actions
      );

    }


    return card;

  }


  function renderIssues() {

    createPanel();


    const issues =
      issueDocument.issues
      || [];


    const unresolved =
      issues.filter(
        issue =>
          issue.status !==
          "resolved"
      );


    if (countBadge) {

      countBadge.textContent =
        String(
          unresolved.length
        );

    }


    if (summaryText) {

      if (
        unresolved.length === 0
      ) {

        summaryText.textContent =
          "没有未处理的 OCR 疑似问题";

      } else {

        summaryText.textContent =
          `共发现 ${issues.length} 项，待处理 ${unresolved.length} 项`;

      }

    }


    list.replaceChildren();


    const ordered = [
      ...unresolved,

      ...issues.filter(
        issue =>
          issue.status ===
          "resolved"
      )
    ];


    if (
      ordered.length === 0
    ) {

      const empty =
        document.createElement(
          "div"
        );


      empty.className =
        "ocr-issues-empty";


      empty.textContent =
        "当前没有检测到明显的 OCR 疑似问题。";


      list.appendChild(
        empty
      );


      return;

    }


    for (
      const issue
      of ordered
    ) {

      list.appendChild(
        renderIssue(
          issue
        )
      );

    }

  }


  async function loadIssues() {

    if (
      !contractId
    ) {
      return;
    }


    try {

      const payload =
        await requestJson(
          `/api/contracts/${
            encodeURIComponent(
              contractId
            )
          }/issues`
        );


      issueDocument = {
        ...payload,

        issues:
          Array.isArray(
            payload.issues
          )
            ? payload.issues
            : []
      };


      renderIssues();


    } catch (error) {

      createPanel();


      summaryText.textContent =
        "无法读取 OCR 待核对项";


      list.innerHTML =
        "";


      const errorNode =
        document.createElement(
          "div"
        );


      errorNode.className =
        "ocr-issues-empty";


      errorNode.textContent =
        error.message;


      list.appendChild(
        errorNode
      );

    }

  }


  /*
   * Expose only the minimum API needed by
   * review.js before finalization.
   */
  window.ContractReviewIssues = {

    getOpenCount,

    reload:
      loadIssues,

    locateText

  };


  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      loadIssues
    );

  } else {

    loadIssues();

  }

})();
