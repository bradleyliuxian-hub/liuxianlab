{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "build",
  "subagent_depth": 1,

  "instructions": [
    "AGENTS.md"
  ],

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 8000
  },

  "tool_output": {
    "max_lines": 400,
    "max_bytes": 20000
  },

  "watcher": {
    "ignore": [
      "node_modules",
      "node_modules/**",
      ".git",
      ".git/**",
      ".venv",
      ".venv/**",
      "venv",
      "venv/**",
      ".mineru",
      ".mineru/**",
      "sessions",
      "sessions/**",
      "storage",
      "storage/**",
      "logs",
      "logs/**",
      "backups",
      "backups/**",
      "**/__pycache__/**",
      "dist",
      "dist/**",
      "build",
      "build/**"
    ]
  },

  "permission": {
    "*": "allow",

    "bash": {
      "*": "allow",

      "git push *": "ask",
      "git push": "ask",

      "git commit *": "ask",
      "git commit": "ask",

      "git reset --hard *": "deny",
      "git reset --hard": "deny",

      "git clean *": "deny",

      "git rebase *": "ask",

      "git checkout -- *": "ask",
      "git restore *": "ask",

      "rm -rf *": "ask",
      "sudo *": "ask",

      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",

      "pm2 restart *": "ask",
      "pm2 reload *": "ask",
      "pm2 delete *": "ask",
      "pm2 stop *": "ask",

      "nginx *": "ask",
      "systemctl *": "ask",

      "docker system prune *": "ask",
      "docker volume rm *": "ask"
    }
  }
}
