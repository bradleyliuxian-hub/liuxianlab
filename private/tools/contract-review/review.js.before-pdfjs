(() => {
  "use strict";


  const params =
    new URLSearchParams(
      window.location.search
    );


  const contractId =
    params.get("id");


  const fileName =
    document.getElementById(
      "fileName"
    );


  const pdfFrame =
    document.getElementById(
      "pdfFrame"
    );


  const openPdfLink =
    document.getElementById(
      "openPdfLink"
    );


  const editor =
    document.getElementById(
      "draftEditor"
    );


  const wordCount =
    document.getElementById(
      "wordCount"
    );


  const saveState =
    document.getElementById(
      "saveState"
    );


  const footerMessage =
    document.getElementById(
      "footerMessage"
    );


  const taskBadge =
    document.getElementById(
      "taskBadge"
    );


  const saveButtons = [
    document.getElementById(
      "saveButton"
    ),

    document.getElementById(
      "saveButtonBottom"
    )
  ].filter(Boolean);


  const finalizeButtons = [
    document.getElementById(
      "finalizeButton"
    ),

    document.getElementById(
      "finalizeButtonBottom"
    )
  ].filter(Boolean);


  let dirty = false;
  let saving = false;


  function setButtonsDisabled(
    disabled
  ) {

    for (
      const button
      of [
        ...saveButtons,
        ...finalizeButtons
      ]
    ) {

      button.disabled =
        Boolean(
          disabled
        );

    }

  }


  function updateCount() {

    const text =
      editor?.value || "";


    const chars =
      text.length;


    const lines =
      text
        ? text.split("\n").length
        : 0;


    if (wordCount) {

      wordCount.textContent =
        `${chars.toLocaleString()} 字符 · ${lines.toLocaleString()} 行`;

    }

  }


  function markDirty() {

    dirty = true;


    if (saveState) {

      saveState.textContent =
        "有未保存修改";

    }

  }


  function markSaved(
    updatedAt
  ) {

    dirty = false;


    if (!saveState) {
      return;
    }


    if (updatedAt) {

      const date =
        new Date(
          updatedAt
        );


      saveState.textContent =
        `已保存 ${date.toLocaleTimeString()}`;

    } else {

      saveState.textContent =
        "已保存";

    }

  }


  async function requestJson(
    url,
    options = {}
  ) {

    const headers = {
      Accept:
        "application/json",

      ...(options.headers || {})
    };


    if (
      options.body
      &&
      !headers["Content-Type"]
    ) {

      headers["Content-Type"] =
        "application/json";

    }


    const response =
      await fetch(
        url,
        {
          credentials:
            "same-origin",

          ...options,

          headers
        }
      );


    let payload =
      null;


    try {

      payload =
        await response.json();

    } catch (_) {
      // Ignore.
    }


    if (
      !response.ok
      ||
      !payload?.ok
    ) {

      throw new Error(
        payload?.error
        ||
        `请求失败：${response.status}`
      );

    }


    return payload;

  }


  async function loadStatus() {

    return requestJson(
      `/api/contracts/${
        encodeURIComponent(
          contractId
        )
      }/status`
    );

  }


  async function loadDraft() {

    return requestJson(
      `/api/contracts/${
        encodeURIComponent(
          contractId
        )
      }/draft`
    );

  }


  async function saveDraft() {

    if (
      saving
      ||
      !editor
    ) {
      return false;
    }


    saving = true;

    setButtonsDisabled(
      true
    );


    if (saveState) {

      saveState.textContent =
        "正在保存…";

    }


    try {

      const payload =
        await requestJson(
          `/api/contracts/${
            encodeURIComponent(
              contractId
            )
          }/draft`,
          {
            method:
              "PUT",

            body:
              JSON.stringify({
                content:
                  editor.value
              })
          }
        );


      markSaved(
        payload.updatedAt
      );


      if (footerMessage) {

        footerMessage.textContent =
          "草稿已保存";

      }


      return true;


    } catch (error) {

      if (saveState) {

        saveState.textContent =
          "保存失败";

      }


      if (footerMessage) {

        footerMessage.textContent =
          error.message;

      }


      window.alert(
        `保存失败：${error.message}`
      );


      return false;


    } finally {

      saving = false;

      setButtonsDisabled(
        false
      );

    }

  }


  function activateCompletedState() {

    dirty = false;


    if (taskBadge) {

      taskBadge.textContent =
        "COMPLETED";

    }


    if (footerMessage) {

      footerMessage.textContent =
        "最终 Markdown 已生成";

    }


    if (saveState) {

      saveState.textContent =
        "校对已完成";

    }


    if (editor) {

      editor.readOnly = true;

    }


    for (
      const button
      of saveButtons
    ) {

      button.disabled = true;

    }


    for (
      const button
      of finalizeButtons
    ) {

      button.disabled = false;

      button.textContent =
        "下载最终 Markdown";


      button.onclick =
        () => {

          window.location.href =
            `/api/contracts/${
              encodeURIComponent(
                contractId
              )
            }/result.md`;

        };

    }

  }


  async function finalize() {

    if (dirty) {

      const saved =
        await saveDraft();


      if (!saved) {
        return;
      }

    }


    const confirmed =
      window.confirm(
        "确认当前 Markdown 已完成人工校对？\n\n确认后将生成最终版本。"
      );


    if (!confirmed) {
      return;
    }


    setButtonsDisabled(
      true
    );


    if (footerMessage) {

      footerMessage.textContent =
        "正在生成最终 Markdown…";

    }


    try {

      await requestJson(
        `/api/contracts/${
          encodeURIComponent(
            contractId
          )
        }/finalize`,
        {
          method:
            "POST"
        }
      );


      activateCompletedState();


    } catch (error) {

      setButtonsDisabled(
        false
      );


      if (footerMessage) {

        footerMessage.textContent =
          error.message;

      }


      window.alert(
        `生成最终版本失败：${error.message}`
      );

    }

  }


  async function init() {

    if (!contractId) {

      document.body.innerHTML =
        '<div style="padding:32px">缺少合同任务编号。</div>';

      return;

    }


    if (
      !editor
      ||
      !pdfFrame
    ) {

      document.body.innerHTML =
        '<div style="padding:32px">校对页面结构不完整。</div>';

      return;

    }


    const previewUrl =
      `/api/contracts/${
        encodeURIComponent(
          contractId
        )
      }/preview`;


    pdfFrame.src =
      previewUrl;


    if (openPdfLink) {

      openPdfLink.href =
        previewUrl;

    }


    setButtonsDisabled(
      true
    );


    try {

      const [
        status,
        draft
      ] =
        await Promise.all([
          loadStatus(),
          loadDraft()
        ]);


      if (fileName) {

        fileName.textContent =
          status.originalName
          || contractId;

      }


      editor.value =
        draft.content || "";


      updateCount();


      markSaved(
        draft.updatedAt
      );


      if (taskBadge) {

        taskBadge.textContent =
          String(
            status.stage
            || status.status
            || "reviewing"
          ).toUpperCase();

      }


      if (
        status.status ===
        "completed"
      ) {

        activateCompletedState();

      } else {

        setButtonsDisabled(
          false
        );


        if (footerMessage) {

          footerMessage.textContent =
            "请对照左侧原合同完成校对";

        }

      }


    } catch (error) {

      if (footerMessage) {

        footerMessage.textContent =
          error.message;

      }


      window.alert(
        `无法打开校对页面：${error.message}`
      );

    }

  }


  if (editor) {

    editor.addEventListener(
      "input",
      () => {

        markDirty();
        updateCount();

      }
    );

  }


  for (
    const button
    of saveButtons
  ) {

    button.addEventListener(
      "click",
      saveDraft
    );

  }


  for (
    const button
    of finalizeButtons
  ) {

    button.addEventListener(
      "click",
      finalize
    );

  }


  window.addEventListener(
    "beforeunload",
    event => {

      if (!dirty) {
        return;
      }


      event.preventDefault();

      event.returnValue = "";

    }
  );


  init();

})();
