{
  "name": "liuxianlab-auth",
  "version": "4.2.0",
  "private": true,
  "description": "Liuxian Lab private tools workspace with Excel standardization jobs.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_ENV=development node server.js",
    "start": "NODE_ENV=production node server.js",
    "user:create": "node create-user.js",
    "user:list": "node list-users.js",
    "test": "node --test tests/contracts/*.test.js tests/excel-decimal-check/*.test.js tests/excel-hardcode-check/*.test.js tests/excel-review/*.test.js tests/journal-entry/*.test.js tests/purchase-reconciliation/*.test.js tests/equity-structure/*.test.js tests/flowchart-excel/*.test.js tests/company-map-lookup/*.test.js",
    "smoke:journal-entry": "node scripts/smoke-journal-entry.js",
    "e2e:journal-entry": "node scripts/e2e-journal-entry.js",
    "bench:hardcode": "node scripts/local/hardcode-benchmark.js",
    "deploy:prod": "bash scripts/local/deploy-production.sh",
    "cleanup:journal-entry": "node scripts/local/cleanup-journal-entry.js",
    "e2e:company-map": "node --test tests/company-map-lookup/frontend-e2e.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.15.0"
  }
}
