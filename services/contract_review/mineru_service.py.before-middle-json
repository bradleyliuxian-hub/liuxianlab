import os
import subprocess
from pathlib import Path

from .database import PROJECT_ROOT


MINERU_BIN = (
    PROJECT_ROOT
    / ".mineru"
    / "bin"
    / "mineru-kit"
)

CONTRACT_STORAGE_ROOT = (
    PROJECT_ROOT
    / "storage"
    / "contracts"
).resolve()


def parse_contract(contract):
    """
    Parse one contract PDF with the local MinerU models.

    Returns information about the generated Markdown file.
    """

    if not MINERU_BIN.is_file():
        raise RuntimeError(
            f"MinerU executable not found: {MINERU_BIN}"
        )

    source_path = (
        PROJECT_ROOT
        / contract["file_path"]
    ).resolve()

    if not source_path.is_file():
        raise RuntimeError(
            f"Source PDF does not exist: {source_path}"
        )

    if (
        source_path != CONTRACT_STORAGE_ROOT
        and CONTRACT_STORAGE_ROOT
        not in source_path.parents
    ):
        raise RuntimeError(
            "Contract source path is outside storage/contracts"
        )

    job_dir = source_path.parent

    parsed_dir = (
        job_dir
        / "parsed"
    )

    parsed_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    output_path = (
        parsed_dir
        / "document.raw.md"
    )

    log_path = (
        parsed_dir
        / "mineru.log"
    )

    if output_path.exists():
        output_path.unlink()

    env = os.environ.copy()

    # Models were already downloaded from ModelScope.
    # Parsing itself must use local models only.
    env[
        "MINERU_MODEL_SOURCE"
    ] = "local"

    command = [
        str(MINERU_BIN),
        "parse",
        str(source_path),
        "-o",
        str(output_path),
        "--tier",
        "standard",
    ]

    print(
        "[mineru] source:",
        source_path,
        flush=True,
    )

    print(
        "[mineru] output:",
        output_path,
        flush=True,
    )

    print(
        "[mineru] log:",
        log_path,
        flush=True,
    )

    with log_path.open(
        "w",
        encoding="utf-8",
    ) as log_file:

        result = subprocess.run(
            command,
            cwd=str(PROJECT_ROOT),
            env=env,
            stdout=log_file,
            stderr=subprocess.STDOUT,
            text=True,
            check=False,
        )

    if result.returncode != 0:

        error_tail = ""

        try:
            error_tail = log_path.read_text(
                encoding="utf-8",
                errors="replace",
            )[-3000:]
        except Exception:
            pass

        raise RuntimeError(
            "MinerU failed with exit code "
            f"{result.returncode}\n"
            f"{error_tail}"
        )

    if not output_path.is_file():
        raise RuntimeError(
            "MinerU finished but document.raw.md was not created"
        )

    output_size = (
        output_path.stat().st_size
    )

    if output_size <= 0:
        raise RuntimeError(
            "MinerU created an empty document.raw.md"
        )

    return {
        "source_path":
            str(source_path),

        "output_path":
            str(output_path),

        "log_path":
            str(log_path),

        "output_size":
            output_size,
    }
