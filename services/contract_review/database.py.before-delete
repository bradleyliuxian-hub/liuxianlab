def update_contract_state(
    contract_id,
    *,
    status,
    stage,
    progress,
    error_message=None,
):

    with connect() as conn:

        with conn.cursor(
            row_factory=dict_row
        ) as cur:

            cur.execute(
                """
                UPDATE contracts

                SET
                    status = %s,
                    stage = %s,
                    progress = %s,
                    error_message = %s,
                    updated_at = NOW()

                WHERE id = %s

                RETURNING
                    id,
                    owner_username,
                    original_name,
                    stored_name,
                    file_path,
                    status,
                    stage,
                    progress,
                    error_message,
                    created_at,
                    updated_at
                """,
                (
                    status,
                    stage,
                    progress,
                    error_message,
                    contract_id,
                ),
            )

            row = cur.fetchone()

    if row is None:
        raise RuntimeError(
            f"Contract not found: {contract_id}"
        )

    return dict(
        row
    )
