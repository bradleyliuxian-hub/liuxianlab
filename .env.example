PORT=8080
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=7
NODE_ENV=development

# Optional: Python interpreter for the Excel standardizer worker.
# Defaults to .venv/bin/python when present, otherwise python3 (must have openpyxl).
# PYTHON_BIN=./.venv/bin/python

# ---------------------------------------------------------------------------
# Contract review — MinerU parse backend
# ---------------------------------------------------------------------------
# Each new contract stores its own backend (local | cloud) in PostgreSQL.
# CONTRACT_MINERU_BACKEND is only the fallback for old records / omitted values;
# local keeps the pinned local MinerU CLI and is the rollback path.
# CONTRACT_MINERU_BACKEND=local

# Cloud API (used when a contract selects cloud; CONTRACT_MINERU_BACKEND is
# only the legacy default for old records / missing per-task values).
# Keep the real token only in the deployment environment / .env, never in Git.
# MINERU_API_TOKEN=
# MINERU_API_BASE_URL=https://mineru.net/api/v4

# Required only when users submit a per-task token. Generate with:
#   openssl rand -hex 32
# 32 bytes as 64 hex chars or base64.
# MINERU_API_TOKEN_ENCRYPTION_KEY=

# Encrypted per-task credential lifetime (hours, 1-168, default 24).
# CONTRACT_CREDENTIAL_TTL_HOURS=24

# Product policy mapping (NOT an equivalence claim):
#   basic -> pipeline, standard -> vlm
# MINERU_API_MODEL_BASIC=pipeline
# MINERU_API_MODEL_STANDARD=vlm
# MINERU_API_LANGUAGE=ch
# MINERU_API_ENABLE_TABLE=true
# MINERU_API_ENABLE_FORMULA=true
# Scanned contracts need OCR; digital PDFs can opt out for speed.
# MINERU_API_IS_OCR=true

# Bounded retries / polling / result-size guards.
# MINERU_API_TIMEOUT_SECONDS=60
# MINERU_API_POLL_INTERVAL_SECONDS=3
# MINERU_API_POLL_TIMEOUT_SECONDS=900
# MINERU_API_MAX_RETRIES=2
# MINERU_API_MAX_ZIP_BYTES=536870912
# MINERU_API_MAX_EXTRACT_BYTES=1073741824

# ---------------------------------------------------------------------------
# 序时账分析 — Journal Entry Analysis
# ---------------------------------------------------------------------------
# Worker / preview interpreter. Defaults to .venv/bin/python, then python3.
# JOURNAL_ENTRY_PYTHON_BIN=./.venv/bin/python
# Max background runtime per job (default 15 minutes).
# JOURNAL_ENTRY_TIMEOUT_MS=900000
# Mapping preview timeout (default 2 minutes).
# JOURNAL_ENTRY_PREVIEW_TIMEOUT_MS=120000
# Concurrent jobs per Node process (default 1).
# JOURNAL_ENTRY_MAX_CONCURRENT=1
# Draft / completed / failed job retention before files + row are removed
# (default 72 hours).
# JOURNAL_ENTRY_RETENTION_HOURS=72

# ---------------------------------------------------------------------------
# 采购与退货对抵 — Purchase & Returns Reconciliation
# ---------------------------------------------------------------------------
# Python interpreter; defaults to .venv/bin/python, then python3.
# PURCHASE_RECONCILIATION_PYTHON_BIN=./.venv/bin/python
# Background worker timeout (default 20 minutes).
# PURCHASE_RECONCILIATION_TIMEOUT_MS=1200000
# Upload inspection timeout (default 2 minutes).
# PURCHASE_RECONCILIATION_INSPECTION_TIMEOUT_MS=120000
# Concurrent jobs per Node process (default 1).
# PURCHASE_RECONCILIATION_MAX_CONCURRENT=1
# Result retention (default 72 hours).
# PURCHASE_RECONCILIATION_RETENTION_HOURS=72

# ---------------------------------------------------------------------------
# 股权结构图识别 — Equity Structure OCR (PaddleOCR, no LLM)
# ---------------------------------------------------------------------------
# Dedicated environment created by scripts/local/setup-equity-ocr.sh.
# EQUITY_STRUCTURE_PYTHON_BIN=./.equity-venv/bin/python
# TILE_WIDTH=1700
# TILE_HEIGHT=1200
# TILE_OVERLAP=0.28
# MAX_TILES=72
# EQUITY_MAX_PIXELS=220000000
# EQUITY_OCR_SCALES=1.0,1.3,1.65,2.0
# EQUITY_DICTIONARY_PATH=./config/equity_structure/company_dictionary.txt
# EQUITY_DICTIONARY_THRESHOLD=91
# EQUITY_LOW_CONFIDENCE=0.80
# EQUITY_STRUCTURE_TIMEOUT_MS=2700000
# EQUITY_STRUCTURE_RETENTION_HOURS=168
# EQUITY_STRUCTURE_MAX_CONCURRENT=1

# ---------------------------------------------------------------------------
# 公司地图地址查询 — Company Map Lookup
# ---------------------------------------------------------------------------
# Provider: auto | amap | baidu. `auto` prefers Amap, then Baidu only when
# the input supplies a region. These keys are OPTIONAL server-side fallbacks:
# users may enter their own provider key in the tool page for a single query.
# A submitted user key takes priority over the env key. Never put real keys
# in HTML/JS, docs, or Git.
# COMPANY_MAP_PROVIDER=auto
# AMAP_WEB_SERVICE_KEY=
# BAIDU_MAP_AK=
# Bounded local tuning (defaults shown). Confirm provider quota/license before
# production use; free developer quota is not a commercial-use license.
# COMPANY_MAP_CONCURRENCY=2
# COMPANY_MAP_MAX_BATCH_SIZE=500
# COMPANY_MAP_CANDIDATE_LIMIT=10
# COMPANY_MAP_RETURNED_CANDIDATES=5
# COMPANY_MAP_REQUEST_TIMEOUT_MS=8000
# COMPANY_MAP_CACHE_TTL_MS=604800000
# COMPANY_MAP_JOB_TTL_MS=7200000
# COMPANY_MAP_AUTO_ACCEPT_THRESHOLD=0.94
# COMPANY_MAP_REVIEW_THRESHOLD=0.66
