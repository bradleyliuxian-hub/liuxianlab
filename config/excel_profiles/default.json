{
  "name": "Liuxian Lab Standard v1.1",
  "description": "可按任务勾选功能的 Excel 标准化方案。profile 保留规则参数，实际开关由每个 job 的 selection 决定。",
  "rules": {
    "trim_text": {
      "enabled": true,
      "label": "清理文本首尾空格"
    },
    "normalize_dates": {
      "enabled": true,
      "label": "统一日期与日期时间格式",
      "format": "yyyy-mm-dd",
      "include_datetime": true,
      "include_date": true,
      "datetime_format": "yyyy-mm-dd hh:mm"
    },
    "header_style": {
      "enabled": true,
      "label": "统一第一行表头样式",
      "fill": "EAF8CC",
      "font_color": "171915",
      "bold": true,
      "horizontal": "left",
      "vertical": "center",
      "row_height": 24
    },
    "autofit_columns": {
      "enabled": true,
      "label": "自动调整列宽",
      "min_width": 8,
      "max_width": 40,
      "padding": 2,
      "scan_rows": 5000
    },
    "sheet_settings": {
      "enabled": true,
      "label": "工作表设置（冻结表头 / 自动筛选）",
      "freeze_header": true,
      "auto_filter": true
    },
    "remove_empty_rows": {
      "enabled": false,
      "label": "删除完全空白行"
    }
  },
  "preview": {
    "rows": 50,
    "columns": 20
  },
  "selectionDefaults": {
    "trim_text": true,
    "normalize_dates": true,
    "normalize_datetime": false,
    "header_style": true,
    "autofit_columns": true,
    "freeze_header": true,
    "auto_filter": true,
    "remove_empty_rows": false
  }
}
